{
  "name": "audio-studio",
  "version": "1.0.0",
  "description": "Song and Movie Store Pro",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "cap:init": "npx cap init 'Azim Space' com.azim.studio --web-dir public",
    "cap:add-android": "npx cap add android",
    "cap:sync": "npx cap sync",
